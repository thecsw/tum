# Host emulation environment for rM2-stuff apps (SDL window emulating the rM).
#
# Build:   docker build -t tum-emulate -f docker/Dockerfile.emulate .
# Run:     docker run --rm -it -v "$PWD:/src:cached" -e DISPLAY=host.docker.internal:0 tum-emulate

FROM debian:bookworm-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        cmake ninja-build pkg-config xxd git git-lfs ca-certificates \
        clang clang-tidy \
        libsdl2-dev libglew-dev libgl1-mesa-dev \
        gdb && \
    rm -rf /var/lib/apt/lists/*

RUN git lfs install --skip-repo

WORKDIR /src
